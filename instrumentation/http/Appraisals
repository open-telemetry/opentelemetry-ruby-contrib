# To facilitate HTTP semantic convention stability migration, we are using
# appraisal to test the different semantic convention modes along with different
# HTTP gem versions. For more information on the semantic convention modes, see:
# https://opentelemetry.io/docs/specs/semconv/non-normative/http-migration/

semconv_stability = %w[dup stable old]

semconv_stability.each do |mode|
  %w[5.0.0 6.0.4].each do |version|
    appraise "http-#{mode}-#{version}" do
      gem 'http', "~> #{version}"
    end
  end
end

# Metrics are exported only when opentelemetry-metrics-sdk is installed.
# The metric is only recorded with stable semantic conventions.
# Only testing v6.0.0 and up because prior versions do not support the purge method.
%w[6.0.4].each do |version|
  appraise "http-stable-#{version}-metrics" do
    gem 'http', "~> #{version}"
    gem 'opentelemetry-metrics-sdk', '~> 0.20.0'
  end
end
