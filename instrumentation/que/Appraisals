appraise 'que-2.4.x-with-activerecord-7.2.x' do
  gem 'que', '< 2.5.0'
  gem 'activerecord', '< 8.0.0'
  gem 'pg', '< 2.0.0', platform: :mri
end

%w[2.4.0 2.4.1].each do |version|
  appraise "que-#{version}-with-latest-pg" do
    gem 'que', "~> #{version}"
    gem 'activerecord'
    gem 'pg', platform: :mri
  end
end
