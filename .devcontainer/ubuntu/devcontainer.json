{
  "name": "otel-ruby-contrib-devcontainer-ubuntu",
  "dockerComposeFile": ["../../docker-compose.yml"],
  "service": "devcontainer-ubuntu",
  "remoteUser": "app",

  "workspaceFolder": "/app",

  // Root devcontainer usually wants all services available
  "runServices": [
    "kafka",
    "jaeger",
    "mysql",
    "mongo",
    "memcached",
    "otelcol",
    "postgres",
    "rabbitmq",
    "redis"
  ]
}
